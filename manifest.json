{
  "manifest_version": 3,
  "name": "TabPaladin",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "Group tabs, save workflows, and manage your browsing sessions efficiently.",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Open TabPaladin",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "src/helper/options.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "ids": []
  }
}
