# TabPaladin sync server: copy to .env and edit. .env is gitignored; never commit it.

# The first admin account, created on the first start when there are no
# accounts. After that these are ignored, so changing them later does not
# change anyone's password (change it from the app). Generate a password with:
#   openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Encrypts importer OAuth refresh tokens (Reddit) at rest. Set it before
# connecting an account; changing it later means re-authorising.
#   openssl rand -hex 32
IMPORT_SECRET=

# The port the server listens on (on the NAS's own network).
# HOST_PORT=18921

# --- Optional --------------------------------------------------------------

# Legacy shared token / script key. Requests sending it as
# "Authorization: Bearer <token>" or "X-API-Key: <token>" act as the account
# that owned the data before accounts were separated (normally the first
# admin). It cannot manage other accounts. Servers from before account logins
# used this as the only password; remove it once every client has signed in,
# unless scripts need it.
# At least 32 characters:  openssl rand -hex 32
# TABPALADIN_TOKEN=

# Only for the one-time upgrade to separate accounts, and only if the database
# already holds more than one account: the username whose data it all is. The
# server refuses to guess and says so at boot.
# TENANCY_OWNER=

# "off" stops the import scheduler. Use it when rehearsing an upgrade on a copy
# of a real database, which would otherwise sweep the real Reddit account.
# IMPORTS_SCHEDULER=off

# Per-account caps. New rows past them are refused; nothing is ever pruned.
# MAX_INBOX_PER_USER=5000
# MAX_PROPOSALS_PER_USER=200

# Which proxies to trust for the client IP and HTTPS detection. The default
# trusts loopback and private (LAN / Docker) addresses only. Use 1 or true if
# your reverse proxy reaches the server from a public address.
# TRUST_PROXY=loopback, uniquelocal

# Extra origins allowed to call the API cross-origin, comma-separated. The
# server's own origin (the PWA) and browser extensions are always allowed.
# CORS_ORIGIN=https://tabs.example.com

# Boot-time database backups (data/sync.db.bak-<timestamp>) to keep.
# BACKUP_KEEP=7

# Failed sign-ins allowed per IP and username per window before requests get
# 429, and a looser ceiling per IP across all usernames (default 5x).
# AUTH_MAX_FAILURES=10
# AUTH_IP_MAX_FAILURES=50
# AUTH_WINDOW_MINUTES=15
