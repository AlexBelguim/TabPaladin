{
    "manifest_version": 2,
    "name": "TabPaladin",
    "version": "1.11.1",
    "description": "Group tabs, save workflows, and manage your browsing sessions efficiently.",
    "incognito": "not_allowed",
    "browser_specific_settings": {
        "gecko": {
            "id": "tabpaladin@extension",
            "strict_min_version": "109.0"
        }
    },
    "permissions": [
        "tabs",
        "bookmarks",
        "storage",
        "unlimitedStorage",
        "downloads",
        "scripting",
        "menus"
    ],
    "background": {
        "scripts": [
            "../src/background/background.js",
            "../src/helper/config.js",
            "../src/helper/identity.js",
            "../src/helper/registration.js",
            "../src/helper/tracking.js",
            "../src/helper/tabs.js",
            "../src/helper/menus.js",
            "../src/helper/save.js",
            "../src/helper/feed.js",
            "../src/helper/vault.js",
            "../src/helper/move.js",
            "../src/helper/router.js"
        ],
        "persistent": false
    },
    "icons": {
        "16": "../assets/icon16.png",
        "48": "../assets/icon48.png",
        "128": "../assets/icon128.png"
    },
    "browser_action": {
        "default_title": "Open TabPaladin",
        "default_icon": {
            "16": "../assets/icon16.png",
            "48": "../assets/icon48.png",
            "128": "../assets/icon128.png"
        }
    },
    "optional_permissions": [
        "<all_urls>"
    ],
    "options_ui": {
        "page": "../src/helper/options.html",
        "open_in_tab": true
    }
}
